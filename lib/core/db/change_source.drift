-- M10.14: a local edit marks the row as the user's again (ARCHITECTURE §14).
--
-- A local edit = `updated_at` changed while the row is `pending` (sync_status 0). Sync merges
-- write `synced`, and re-sealing (M11.7) leaves `updated_at` alone, so neither touches the marks:
-- rows changed by the agent keep `updated_by = 'agent'` until the user edits them here.
-- The inner UPDATE doesn't change `updated_at`, so it can't fire the trigger again.

import 'tables/profiles.dart';
import 'tables/categories.dart';
import 'tables/transactions.dart';
import 'tables/budgets.dart';
import 'tables/goals.dart';
import 'tables/goal_contributions.dart';
import 'tables/reminders.dart';

CREATE TRIGGER profiles_local_change_source AFTER UPDATE OF updated_at ON profiles
  WHEN NEW.sync_status = 0 AND NEW.updated_at IS NOT OLD.updated_at
    AND (NEW.updated_by <> 'user' OR NEW.agent_proposal_id IS NOT NULL)
BEGIN
  UPDATE profiles SET updated_by = 'user', agent_proposal_id = NULL WHERE id = NEW.id;
END;

